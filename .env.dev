####### API
API_PET_BASE_URL="https://petstore.swagger.io"
AZURE_API_SCOPE="https://graph.microsoft.com/.default"


######## AZURE DEVOPS INTEGRATION
AZURE_DEVOPS_INTEGRATION_ENABLED=false ##Activar o desactivar la integración con Azure DevOps. Útil para entornos de desarrollo o pruebas locales donde no se desea conectar a Azure DevOps.
AZURE_DEVOPS_ORG="PlaywrightIntegration"
AZURE_DEVOPS_PROJECT="Integracion2"
AZURE_DEVOPS_PAT="" ## Personal Access Token (PAT) para autenticación con Azure DevOps. Asegúrate de mantenerlo seguro y no compartirlo públicamente.
AZURE_TESTPLAN_ID="29"
AZURE_API_VERSION=7.1
MAX_RETRIES=3 ## Número de reintentos internos del cliente HTTP de Azure DevOps.
ENABLE_BUG_CREATION=false
ENABLE_TRACE_ATTACHMENTS=true
AZURE_TLS_REJECT_UNAUTHORIZED=true ## Validación TLS para llamadas HTTPS a Azure DevOps. false = deshabilitada (útil con certificados self-signed o proxies corporativos). Cambiar a true en entornos con certificados confiables.

